CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_HZ=1000

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS buffers in PSRAM; internal RAM is held by esp-sr and the esp_hosted SDIO buffers.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Wi-Fi runs over the onboard ESP32-C6 via esp_hosted + esp_wifi_remote (both in
# Cargo.toml). Waveshare's own P4 example uses their default (SDIO) config with no
# custom pins, so nothing board-specific is needed here. The C6 must run the
# esp_hosted slave firmware (Waveshare ships it).

# 32MB PSRAM; frees internal RAM and holds the 720x720 framebuffer.
# Values from Waveshare's P4 examples (11_esp_brookesia_phone).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# MIPI-DSI display bring-up (ST7703) needs the P4 experimental paths.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Keep esp_hosted SDIO DMA buffers in INTERNAL RAM: in PSRAM they contend with the
# display's continuous framebuffer scanout and SDIO TX times out (Unrecoverable).
# Fit internal RAM instead by moving esp_hosted task stacks to PSRAM and shrinking
# the SDIO queues.
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=10
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=10

# LVGL 9.2 (values from Waveshare 10_lvgl_demo_v9).
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# esp-sr: "Jarvis" wake word and VADNet, loaded from the "model" partition in partitions.csv.
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
