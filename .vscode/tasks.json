			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run mastertech-mobile dev",
			"type": "shell",
			"command": "cargo run -p mastertech-mobile",
			"args": [],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "Run mastertech-mobile app",
			"type": "shell",
			"command": "cargo run -p mastertech-mobile",
			"args": [],
			"isBackground": true,
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "cargo check displays",
			"type": "shell",
			"command": "cargo",
			"args": [
				"check",
				"-p",
				"displays"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		}
