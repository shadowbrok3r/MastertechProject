    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'mastertech_rust_egui'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=mastertech_rust_egui",
                    "--package=mastertech_rust_egui"
                ],
                "filter": {
                    "name": "mastertech_rust_egui",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            // "env": { "RUST_BACKTRACE": "full" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'mastertech_rust_egui'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=mastertech_rust_egui",
                    "--package=mastertech_rust_egui"
                ],
                "filter": {
                    "name": "mastertech_rust_egui",
                    "kind": "bin"
                }
            },
            "args": ["RUST_BACKTRACE=1"],
            "cwd": "${workspaceFolder}"
        }
    ]
}