{
    "search.useIgnoreFiles": false,
    "workbench.editor.decorations.colors": true,
    "workbench.editor.decorations.badges": true,
    "diffEditor.experimental.showEmptyDecorations": false,
    "diffEditor.codeLens": false,

    // Don't watch or search the ~149 GB target tree.
    "files.watcherExclude": { "**/target/**": true, "**/.git/**": true },
    "search.exclude": { "**/target/**": true },

    // Skip tests/benches/examples in analysis and flycheck.
    "rust-analyzer.cargo.allTargets": false,

    // Cap parallel rustc jobs so checks leave cores/RAM for the editor.
    "rust-analyzer.cargo.extraEnv": { "CARGO_BUILD_JOBS": "12" },
    "rust-analyzer.check.extraEnv": { "CARGO_BUILD_JOBS": "12" },

    // Cap rust-analyzer's own worker threads.
    "rust-analyzer.numThreads": 12,
    "rust-analyzer.cargo.targetDir": true,
    // mtechserver is wasm-only; --exclude requires --workspace, so override flycheck.
    "rust-analyzer.check.overrideCommand": [
        "cargo",
        "check",
        "--workspace",
        "--exclude",
        "mtechserver",
        "--keep-going",
        "--message-format=json-diagnostic-rendered-ansi"
    ]
}
