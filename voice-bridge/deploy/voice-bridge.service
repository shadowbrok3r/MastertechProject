# User unit on the ZeroClaw box. Install with:
#
#   install -Dm644 deploy/voice-bridge.service ~/.config/systemd/user/voice-bridge.service
#   systemctl --user daemon-reload && systemctl --user enable --now voice-bridge
#
# Optional ~/.config/voice-bridge/env (chmod 600): VB_TECH_EMAIL / VB_TECH_PASSWORD
# sign turns in as that tech; WHISPER_*/PIPER_* override the model paths.
[Unit]
Description=voice-bridge - bench voice console relay master (STT -> assistant -> TTS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
ExecStart=%h/mtech/target/release/voice-bridge --relay VOICE-DEV
Environment=RUST_LOG=info
EnvironmentFile=-%h/.config/voice-bridge/env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
