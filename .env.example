BUCKET_DEV_LINUX_URL=
BUCKET_DEV_WINDOWS_URL=
BUCKET_URL=

# ZeroClaw agent gateway. Either value empty disables the dispatcher,
# session viewer and event watcher at runtime.
ZEROCLAW_GATEWAY_URL=
ZEROCLAW_GATEWAY_TOKEN=
