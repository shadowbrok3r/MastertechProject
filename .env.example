# Copy to `.env` at this repo root. Used at **compile time** by `database/build.rs`
# (and optionally by other crates that read the same file).
#
# --- Rotate after any exposure (Git history, leaks, departing staff) ---
# SURREAL_GUEST_PASSWORD   → SurrealDB `guest` access password on your instance
# SCAFFOLD_PASS            → Scaffold / backend password
# ISSUE_TOKEN, DOWNLOAD_TOKEN → GitHub (or other) API tokens used by the app
# ODOO_API_KEY             → Odoo API key / password for JSON-RPC user
# DB_URL*, WS_*            → If URLs embed revoked credentials, rotate endpoints/tokens
#
# Optional overrides (defaults applied in database/build.rs if unset or empty):
# BUCKET_DEV_LINUX_URL, BUCKET_DEV_WINDOWS_URL, BUCKET_URL
# ODOO_JSONRPC_URL, ODOO_DB, ODOO_UID
# PRESTASHOP_API_URL, PRESTASHOP_API_URL_WASM

USER_SCOPE=
DB=
NS=
SCAFFOLD_URL=
SCAFFOLD_USER=
SCAFFOLD_PASS=
DB_URL=
STORAGE_URL=
REGION=
DB_URL_DEV=
DB_URL_LOCAL=
DB_URL_BETA=
WS_CLIENT_URL_LOCAL=
WS_MASTER_URL_LOCAL=
WS_CLIENT_URL=
WS_MASTER_URL=
ISSUE_TOKEN=
DOWNLOAD_TOKEN=
ODOO_API_KEY=

# Was previously hardcoded in source — set to your Surreal `guest` password.
SURREAL_GUEST_PASSWORD=

# Optional (see defaults in database/build.rs):
# BUCKET_DEV_LINUX_URL=
# BUCKET_DEV_WINDOWS_URL=
# BUCKET_URL=
# ODOO_JSONRPC_URL=
# ODOO_DB=
# ODOO_UID=
# PRESTASHOP_API_URL=
# PRESTASHOP_API_URL_WASM=

# displays crate (compile-time via displays/build.rs):
# GEMINI_API_KEY=
