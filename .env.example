DB=
NS=
SCAFFOLD_URL=
SCAFFOLD_USER=
SCAFFOLD_PASS=
DB_URL=
STORAGE_URL=
REGION=
DB_URL_DEV=
DB_URL_LOCAL=
DB_URL_BETA=
DB_ROOT_USER=
DB_ROOT_PASS=
WS_CLIENT_URL_LOCAL=
WS_MASTER_URL_LOCAL=
WS_CLIENT_URL=
WS_MASTER_URL=
ODOO_API_KEY=
ODOO_JSONRPC_URL=
