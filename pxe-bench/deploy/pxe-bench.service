[Unit]
Description=Mastertech bench PXE appliance (ProxyDHCP + TFTP + HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binary on a normal (executable) FS; config + payload roots on the noexec .img.
WorkingDirectory=/mnt/tech/pxe
ExecStart=/usr/local/bin/pxe-bench /mnt/tech/pxe/pxe-bench.toml
Restart=on-failure
RestartSec=3

# :67 (DHCP) and :69 (TFTP) are privileged ports. Running as root is simplest
# for a trusted-LAN bench box. To run as a dedicated unprivileged user instead,
# set User=pxe and keep the capability grant below:
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
