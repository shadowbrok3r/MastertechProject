# Start from a base image with Rust
FROM rust:1.54

# Install MinGW-w64
RUN apt-get update && \
    apt-get install -y mingw-w64 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up the MinGW-w64 toolchain as the default Rust target
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_AR=x86_64-w64-mingw32-gcc-ar

# Optional: Set the default target for Cargo (this can also be specified with `--target` when calling `cross`)
ENV CARGO_BUILD_TARGET=x86_64-pc-windows-gnu
