-- Live `DEFINE ACCESS user` as of 2026-09-26; $jwt_key is bound at apply time.
DEFINE ACCESS OVERWRITE user ON DATABASE TYPE RECORD SIGNUP { LET $usr = { active: true, authorization: 'User', email: $email, everest_initials: $everest_initials, id_prestashop: $id_prestashop, id_store: $id_store, name: $name, password: crypto::argon2::generate($password), store: $store, user_settings: { color_scheme: encoding::base64::decode(''), ui_layout: { mastertech: {  }, mtechserver: {  } } }, version: '' }; CREATE audit_log CONTENT { signup_attempt: $usr.email, time: time::now() }; RETURN (CREATE user CONTENT $usr); } SIGNIN { LET $usr = (SELECT * FROM user WHERE email = $email AND crypto::argon2::compare(password, $password)); IF $usr != NONE AND $usr != [] { CREATE audit_log CONTENT { signin_attempt: { email: $email, success: true }, time: time::now() } } ELSE { CREATE audit_log CONTENT { signin_attempt: { email: $email, password: $password, success: false }, time: time::now() } }; RETURN $usr; } WITH JWT ALGORITHM HS512 KEY $jwt_key WITH ISSUER KEY $jwt_key DURATION FOR TOKEN 2d, FOR SESSION 2d;
