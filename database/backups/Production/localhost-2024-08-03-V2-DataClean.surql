DEFINE FUNCTION fn::compare_clients($client_id: record<connected_client>) {
LET $computers = (SELECT * FROM computer);
FOR $comp IN $computers { IF meta::id($client_id) = meta::id($comp.id) { UPDATE connected_client SET computer = <record> $comp.id; }; };
LET $cli_id = meta::id($client_id);
LET $parts = string::split($cli_id, ':');
LET $hostname = array::at($parts, 0);
LET $computer_hash = array::at($parts, 1);
LET $connection_string = string::concat($hostname, ':', $computer_hash);
UPDATE connected_client SET connection_string = $connection_string WHERE id = $client_id;
UPDATE connected_client SET connected = true WHERE id = $client_id;
LET $user = (SELECT * FROM user WHERE id == $auth.id);
FOR $user_client IN $user.connected_clients { IF $user_client != $client_id { UPDATE connected_client SET assigned_user = $auth.id WHERE id = $client_id; }; };
} PERMISSIONS FULL;
DEFINE FUNCTION fn::mark_all_completion($record: record<task>, $completion: bool) { UPDATE $record SET completed = $completion; } PERMISSIONS FULL;
DEFINE FUNCTION fn::mark_all_due_today($record: record<task>) { UPDATE $record SET due_date = time::now(); } PERMISSIONS FULL;
DEFINE FUNCTION fn::rm_tasknote_from_task($targetNoteId: record<task_note>) {
LET $taskNotesArray = (SELECT id, task_note FROM task WHERE task_note != NONE);
LET $task = function($taskNotesArray, $targetNoteId) {
	    const [taskNotesArray, targetNoteId] = arguments;
	    for (const task of taskNotesArray) {
	        for (const note of task.task_note) {
	            if (`${note}` == `${targetNoteId}`) {
	                return task.id;
	            }
	        }
	    }
	    return null;
	};
IF $task != NULL {
LET $notes = array::flatten((SELECT VALUE task_note FROM $task));
LET $idx = array::find_index($notes, $targetNoteId);
IF $idx != NULL {
LET $new_arr = array::remove($notes, $idx);
UPDATE $task SET task_note = $new_arr;
} ELSE { RETURN string::concat('Could not find task_note: ', $targetNoteId, ' in the task: ', $task.id); };
} ELSE { RETURN string::concat('Could not find task with associated task_note: ', $targetNoteId); };
} COMMENT 'Finds the associated task with the given note ID, and removes it from the list of notes in that task' PERMISSIONS FULL;

DEFINE ACCESS user ON DATABASE TYPE RECORD
    SIGNUP (CREATE user CONTENT { email: $email, everest_initials: $everest_initials, name: $name, password: crypto::argon2::generate($password), store: $store }) 
    SIGNIN (SELECT * FROM user WHERE email = $email AND crypto::argon2::compare(password, $password))
    DURATION FOR SESSION 1d
;

