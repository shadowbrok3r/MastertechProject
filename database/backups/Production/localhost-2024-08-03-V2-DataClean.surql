}; };
DEFINE EVENT update ON task WHEN $event = 'UPDATE' THEN { IF $auth.id != NONE { CREATE notification CONTENT { notification_description: string::concat($auth.name, ' has modified task ', $value.task_name), notification_type: 'Task Update', status: 'Unread', user: $auth.id }; }; };

