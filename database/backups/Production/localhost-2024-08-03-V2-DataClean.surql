DEFINE EVENT created ON task_note WHEN $event = 'CREATE' THEN {
UPDATE $value.id MERGE { created_at: time::now(), everest_initials: $auth.everest_initials };
UPDATE task SET task_note += $value.id WHERE id = $value.task_id;
RETURN AFTER;
};
DEFINE EVENT delete ON task_note WHEN $event = 'DELETE' THEN { RETURN fn::rm_tasknote_from_task($before.id); };
DEFINE EVENT update ON task_note WHEN $event = 'UPDATE' THEN {
LET $users = (SELECT email FROM user);
FOR $user IN $users { IF string::contains($value.note, $user.email) { CREATE notification CONTENT { notification_description: string::concat($user.email, ' tagged in note'), notification_type: 'New Note', status: 'Unread', user: (SELECT id FROM user WHERE email == $user.email) }; } ELSE { CREATE notification CONTENT { notification_description: 'New Note', notification_type: 'New Note', status: 'Unread', user: $auth.id }; }; };
};

