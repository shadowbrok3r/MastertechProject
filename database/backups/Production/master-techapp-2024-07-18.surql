-- ------------------------------
-- TABLE: task
-- ------------------------------

DEFINE TABLE task TYPE ANY SCHEMALESS CHANGEFEED 1w PERMISSIONS FULL;

DEFINE FIELD assignee ON task TYPE record<user> DEFAULT $auth.id PERMISSIONS FULL;
DEFINE FIELD completed ON task TYPE bool DEFAULT false PERMISSIONS FULL;
DEFINE FIELD dep ON task TYPE option<string> DEFAULT $auth.store PERMISSIONS FULL;
DEFINE FIELD due_date ON task TYPE string DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD everest_initials ON task TYPE string DEFAULT $auth.everest_initials PERMISSIONS FULL;
DEFINE FIELD priority ON task TYPE option<string> PERMISSIONS FULL;
DEFINE FIELD service_number ON task TYPE option<string> PERMISSIONS FULL;
DEFINE FIELD service_ticket ON task TYPE option<record<service_order>> PERMISSIONS FULL;
DEFINE FIELD status ON task TYPE string DEFAULT 'Todo' PERMISSIONS FULL;
DEFINE FIELD task_description ON task TYPE option<string> PERMISSIONS FULL;
DEFINE FIELD task_name ON task TYPE string PERMISSIONS FULL;
DEFINE FIELD task_note ON task TYPE option<array<record<task_note>>> PERMISSIONS FULL;
DEFINE FIELD task_note[*] ON task TYPE record<task_note> PERMISSIONS FULL;

DEFINE EVENT created ON task WHEN $event = 'CREATE' THEN {
UPDATE task SET created_at = time::now() WHERE id = $value.id;
CREATE notification CONTENT { notification_description: string::concat('New Task for ', $value.assignee.name), notification_type: 'Task Created', status: 'Unread', user: $auth.id };
};
DEFINE EVENT update ON task WHEN $event = 'UPDATE' THEN { CREATE notification CONTENT { notification_description: string::concat($auth.name, ' has modified task ', $value.task_name), notification_type: 'Task Update', status: 'Unread', user: $auth.id }; };

-- ------------------------------
-- TABLE: task_note
-- ------------------------------

DEFINE TABLE task_note TYPE ANY SCHEMALESS PERMISSIONS FULL;

DEFINE FIELD everest_initials ON task_note TYPE string PERMISSIONS FULL;
DEFINE FIELD note ON task_note TYPE string PERMISSIONS FULL;
DEFINE FIELD task_id ON task_note TYPE record<task> PERMISSIONS FULL;

DEFINE EVENT created ON task_note WHEN $event = 'CREATE' THEN {
UPDATE task_note MERGE { created_at: time::now(), everest_initials: $auth.everest_initials } WHERE id = $value.id;
UPDATE task SET task_note += $value.id WHERE id = $value.task_id;
RETURN AFTER;
};
DEFINE EVENT update ON task_note WHEN $event = 'CREATE' THEN {
LET $users = (SELECT email FROM user);
FOR $user IN $users { IF string::contains($value.note, $user.email) { CREATE notification CONTENT { notification_description: string::concat($user.email, ' tagged in note'), notification_type: 'New Note', status: 'Unread', user: (SELECT id FROM user WHERE email == $user.email) }; } ELSE { CREATE notification CONTENT { notification_description: 'New Note', notification_type: 'New Note', status: 'Unread', user: $auth.id }; }; };
};

