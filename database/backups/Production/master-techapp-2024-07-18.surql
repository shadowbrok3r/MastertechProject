DEFINE TABLE connected_client TYPE NORMAL SCHEMALESS PERMISSIONS FULL;

DEFINE FIELD command_history ON connected_client TYPE option<array<string>> PERMISSIONS FOR select, create, update, delete WHERE FULL;
