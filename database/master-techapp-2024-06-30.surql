DEFINE FUNCTION fn::compare_clients($client_id: record<connected_client>) {
LET $computers = (SELECT * FROM computer);
FOR $comp IN $computers { IF meta::id($client_id) = meta::id($comp.id) { UPDATE connected_client SET computer = <record> $comp.id; }; };
LET $cli_id = meta::id($client_id);
LET $parts = string::split($cli_id, ':');
LET $hostname = array::at($parts, 0);
LET $computer_hash = array::at($parts, 1);
LET $connection_string = string::concat($hostname, ':', $computer_hash);
UPDATE connected_client SET connection_string = $connection_string WHERE id = $client_id;
UPDATE connected_client SET assigned_user = $auth.id WHERE id = $client_id;
UPDATE connected_client SET connected = true WHERE id = $client_id;
UPDATE user SET connected_clients += $value.id WHERE id = $auth.id;
} PERMISSIONS FULL;
DEFINE FUNCTION fn::mark_all_completion($ids: array, $completion: bool) { FOR $id IN $ids { UPDATE task SET complete = $completion WHERE id = type::thing('task', $id); }; } PERMISSIONS FULL;
DEFINE FUNCTION fn::mark_all_due_today($ids: array<record<task>>) { FOR $id IN $ids { UPDATE task SET due_date = time::now() WHERE id = $id; }; } PERMISSIONS FULL;

-- ------------------------------
-- SCOPES
-- ------------------------------

DEFINE SCOPE user SESSION 1d SIGNUP (CREATE user CONTENT { email: $email, everest_initials: $everest_initials, name: $name, password: crypto::argon2::generate($password), store: $store }) SIGNIN (SELECT * FROM user WHERE email = $email AND crypto::argon2::compare(password, $password));

